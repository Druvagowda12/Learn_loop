# ============================================================
# LearnLoop .gitignore
# ============================================================

# ----- Secrets (NEVER commit these) -----
.env
.env.*
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# ----- Virtual Environments -----
.venv/
venv/
ENV/
env/

# ----- Databases (runtime data — not source code) -----
*.db
*.sqlite3
instance/

# ----- Pytest / Coverage -----
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.xml

# ----- Distribution / Build -----
dist/
build/
*.egg-info/
.eggs/

# ----- Node (not used, but block accidental commits) -----
node_modules/

# ----- Logs -----
*.log
logs/

# ----- OS / IDE metadata -----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
