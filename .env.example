# LearnLoop — Local Development Environment
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git.

# ----- Flask Core -----
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_DEBUG=1

# ----- Database -----
# Leave as-is for local SQLite, or point to PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/learnloop
DATABASE_URL=sqlite:///learnloop.db

# ----- AI Chatbot (optional — chatbot works without these via built-in KB) -----
# Get a free Gemini key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-google-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
# AI_API_KEY=your-generic-ai-key-here
